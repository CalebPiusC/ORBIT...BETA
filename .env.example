GEMINI_API_KEY=your_actual_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
# Tried once, only if GEMINI_MODEL fails with 503/504 or a network error, and
# only before any tool has run. Leave blank to disable. Checked 2026-10-10.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Deadline for every request to the model, in seconds. Leave it set: without a
# deadline the SDK asks httpx to wait forever, so a blocked connection hangs
# with no reply and no error. Raise it for a slow link; never remove it.
ORBIT_HTTP_TIMEOUT=60
# Every record (memory, conversations, daily plan) is namespaced by this id,
# even while there is only one real user. See docs/HANDOFF.md (Phase 6).
ORBIT_USER_ID=caleb
