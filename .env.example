GEMINI_API_KEY=your_actual_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
# Tried once, only if GEMINI_MODEL fails with 503/504 or a network error, and
# only before any tool has run. Leave blank to disable. Checked 2026-10-10.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Optional Deep-mode OpenRouter chain. Add your OpenRouter key to enable it.
# Pinned free models are tried in order, then OPENROUTER_FALLBACK_MODEL.
# Keep model ids here/.env, never in provider code; free availability can change.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_1=google/gemma-4-31b-it:free
OPENROUTER_MODEL_2=qwen/qwen3.8-27b:free
OPENROUTER_MODEL_3=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
# Deadline for every request to the model, in seconds. Leave it set: without a
# deadline the SDK asks httpx to wait forever, so a blocked connection hangs
# with no reply and no error. Raise it for a slow link; never remove it.
ORBIT_HTTP_TIMEOUT=60
# Every record (memory, conversations, daily plan) is namespaced by this id,
# even while there is only one real user. See docs/HANDOFF.md (Phase 6).
ORBIT_USER_ID=caleb
# REQUIRED to serve the web app. This signs the session cookie, so a guessable
# or committed value lets anyone forge a signed-in session. `run_app` refuses to
# start when this is unset or still the committed default ("orbit-dev-secret").
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it secret and stable: changing it signs everyone out. (run_demo.py mints
# a random throwaway key when this is blank, so the stub launcher still starts.)
ORBIT_SECRET_KEY=
# Heartbeat (background reminders). Times are local, Africa/Lagos. Quiet hours
# are 22:00-08:00 and hold automatic notices back. Plan hour must be 8-21 so the
# plan check can fire outside quiet hours.
HEARTBEAT_PLAN_HOUR=10
# A home-chat message counts as a check-in. Notify after this many days without one.
HEARTBEAT_CHECKIN_GAP_DAYS=2
# How often the background scheduler checks, in seconds (5-3600).
HEARTBEAT_INTERVAL_SECONDS=60
# Phone push through ntfy.sh. Leave NTFY_TOPIC blank to turn push off. The topic
# is a secret: anyone who knows it can read your notices. Pick a long random one,
# e.g. `python -c "import secrets; print('orbit-' + secrets.token_urlsafe(18))"`.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Console log level for Orbit's own loggers (orbit.*). INFO prints the voice
# dependency report at boot and the traceback behind any voice failure.
ORBIT_LOG_LEVEL=INFO
# Voice input uses faster-whisper locally. First use downloads the model into
# the standard Hugging Face cache; clips are temporary and are not retained.
# ffmpeg is NOT needed for the browser's WebM/Opus clips: faster-whisper decodes
# through PyAV, which bundles the FFmpeg libraries. A model directory on disk may
# be given instead of a name, e.g. ORBIT_WHISPER_MODEL=/opt/models/faster-whisper-base
ORBIT_WHISPER_MODEL=base
ORBIT_WHISPER_DEVICE=cpu
ORBIT_WHISPER_COMPUTE_TYPE=int8
